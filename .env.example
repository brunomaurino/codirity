# Codirity — environment variables
# Copy to .env.local for local dev. In production, set these in the Vercel dashboard
# (per-environment). Values here are placeholders / documentation only.

# ─── Stripe Payment Links (Bundle B / offer.ts) ──────────────────────────────
# Public checkout links for each plan. offer.ts falls back to "#" when unset, so the
# site builds without real links in v1. Set the REAL Production-scoped links in Vercel
# before launch; use "#" (or a test link) on Preview to avoid live checkouts.
NEXT_PUBLIC_STRIPE_LINK_STANDARD=
NEXT_PUBLIC_STRIPE_LINK_PRO=
NEXT_PUBLIC_STRIPE_LINK_FOUNDING=

# ─── Canonical site URL (Bundle A / site.ts) ─────────────────────────────────
# The canonical origin used for metadataBase, canonical URLs, OG image, and sitemap.
# Production: https://www.codirity.com. Leave unset on Preview to fall back to the
# Vercel-provided deployment URL. (VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL / VERCEL_ENV
# are injected automatically by Vercel — do not set them by hand.)
NEXT_PUBLIC_SITE_URL=

# ─── Analytics (GA4) ─────────────────────────────────────────────────────────
# GA4 Measurement ID. Leave blank on Preview to avoid polluting production analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Contact form SMTP (api/contact) ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
